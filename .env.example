# ── Zemen environment ────────────────────────────────────────────────
# Copy to .env and adjust. Everything here has a sensible default.

# HTTP port for the API server
PORT=3001

# Storage driver.
#   Leave DATABASE_URL empty  -> SQLite file (zero-setup local dev, default)
#   Set DATABASE_URL          -> PostgreSQL, e.g.
#   DATABASE_URL=postgres://zemen:zemen@localhost:5432/zemen
DATABASE_URL=

# SQLite file location (used only when DATABASE_URL is empty)
DB_FILE=./data/zemen.db

# Secret used to sign auth tokens. CHANGE IN PRODUCTION.
JWT_SECRET=zemen-dev-secret-change-me

# DEV_MODE=true shows demo helpers (OTP peek endpoint, login hints).
# Set to false in production.
DEV_MODE=true

# Default currency for new deals
DEFAULT_CURRENCY=ETB
